# Gemma served with vLLM on AMD Developer Cloud (AMD Instinct GPU, ROCm) — OpenAI-compatible
AMD_LLM_BASE_URL=http://<your-amd-vm-ip>:8000/v1
AMD_LLM_API_KEY=<your-vllm-api-key>
AMD_LLM_MODEL=google/gemma-3-12b-it

# Optional: Whisper served with vLLM on AMD (for audio voice notes)
AMD_WHISPER_BASE_URL=http://<your-amd-vm-ip>:8001/v1
AMD_WHISPER_MODEL=openai/whisper-large-v3

# Optional: Evolus workflow that distributes the briefing
EVOLUS_API_KEY=
EVOLUS_APP_ID=
EVOLUS_WORKFLOW_ID=
